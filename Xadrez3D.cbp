<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Xadrez3D" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Linux Debug">
				<Option platforms="Unix;" />
				<Option output="bin/Debug/Xadrez3D" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Option working_dir="." />
				<Compiler>
					<Add option="-g" />
				</Compiler>
				<Linker>
					<Add library="glfw" />
					<Add library="GLEW" />
					<Add library="GL" />
				</Linker>
			</Target>
			<Target title="Linux Release">
				<Option platforms="Unix;" />
				<Option output="bin/Release/Xadrez3D" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Option working_dir="." />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add library="glfw" />
					<Add library="GLEW" />
					<Add library="GL" />
				</Linker>
			</Target>
			<Target title="Windows Debug">
				<Option platforms="Windows;" />
				<Option output="bin/Windows-Debug/Xadrez3D" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Windows-Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Option working_dir="." />
				<Compiler>
					<Add option="-g" />
					<Add option="-DGLEW_STATIC" />
					<Add directory="libs/glfw/include" />
					<Add directory="libs/glew/include" />
				</Compiler>
				<Linker>
					<Add option="-static-libgcc" />
					<Add option="-static-libstdc++" />
					<Add library="glfw3dll" />
					<Add library="opengl32" />
					<Add library="gdi32" />
					<Add directory="libs/glfw/lib-mingw-w64" />
				</Linker>
			</Target>
			<Target title="Windows Release">
				<Option platforms="Windows;" />
				<Option output="bin/Windows-Release/Xadrez3D" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Windows-Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Option working_dir="." />
				<Compiler>
					<Add option="-O2" />
					<Add option="-DGLEW_STATIC" />
					<Add directory="libs/glfw/include" />
					<Add directory="libs/glew/include" />
				</Compiler>
				<Linker>
					<Add option="-static-libgcc" />
					<Add option="-static-libstdc++" />
					<Add option="-s" />
					<Add library="glfw3dll" />
					<Add library="opengl32" />
					<Add library="gdi32" />
					<Add directory="libs/glfw/lib-mingw-w64" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-std=c++14" />
			<Add option="-Wall" />
			<Add option="-fexceptions" />
			<Add directory="include" />
			<Add directory="libs/glm" />
		</Compiler>
